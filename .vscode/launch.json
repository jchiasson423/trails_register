{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Start Server",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "skipFiles": [
                "<node_internals>/**",
                "${workspaceFolder}/node_modules/**/*.js"
            ]
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open Browser",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "🚀 Start Fullstack (Server + Browser)",
            "configurations": ["Start Server", "Open Browser"]
        }
    ]
}
